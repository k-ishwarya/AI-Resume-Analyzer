# AI Resume Analyzer - Backend Environment Variables
APP_ENV=development
PORT=8000
SECRET_KEY=change_this_to_a_super_secret_jwt_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Admin account (email that gets ADMIN role on register/login)
ADMIN_EMAIL=your_admin_email@example.com

# Upload Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx"]

# Frontend URL (for CORS and email reset links)
FRONTEND_URL=http://localhost:5173

# SMTP Email (optional - falls back to log if unconfigured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
EMAILS_FROM_EMAIL=your_email@gmail.com
EMAILS_FROM_NAME="AI Resume Analyzer"
