# AI Resume Analyzer - Backend Environment Variables
APP_ENV=development
PORT=8000
SECRET_KEY=change_this_to_a_super_secret_jwt_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration:
# For local development with zero setup, SQLite is used by default:
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres
# For PostgreSQL / Supabase, uncomment and set your connection string:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Upload Constraints
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=["pdf", "docx"]
